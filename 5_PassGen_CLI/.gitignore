# .gitignore

# Dependencias de Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Archivos generados por el sistema operativo
.DS_Store
Thumbs.db

# Archivos de entorno y configuración sensible
.env
.env.local
.env.*.local

# Logs
*.log

# Archivos generados por el CLI (contraseñas)
password.txt
*.txt
*.pass
*.password

# Archivos de build o empaquetado
dist/
build/

# Editor y IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Coverage
coverage/
.nyc_output/

# Archivos temporales
.tmp/
temp/